{
    "manifest_version": 3,
    "name": "Reading List Exporter",
    "description": "Export your Chrome Reading List to a CSV file.",
    "version": "1.0.0",
    "permissions": [
        "readingList",
        "downloads"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png"
    },
    "action": {
        "default_title": "Export Reading List to CSV",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}